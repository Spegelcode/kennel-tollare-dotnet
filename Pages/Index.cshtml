@page
@model KennelTollare.Pages.IndexModel
@{
    var content = Model.Content;
    var litters = Model.Litters;
}
<header class="site-header" id="top">
    <a class="brand" href="#start"><span class="brand-mark">ST</span><span><strong>@content.Site.Name</strong><small>TOLLARE</small></span></a>
    <button class="menu-toggle" aria-label="Öppna meny" aria-expanded="false"><span></span><span></span></button>
    <nav class="nav" aria-label="Huvudmeny">
        <a href="#start" data-tab="start">Start</a><a href="#om-oss" data-tab="om-oss">Om oss</a><a href="#hundarna" data-tab="hundarna">Hundarna</a><a href="#kullar" data-tab="kullar">Kullar</a><a href="#vardag" data-tab="vardag">Vår vardag</a><a class="nav-cta" href="#kontakt" data-tab="kontakt">Hör av dig <span>↗</span></a>
    </nav>
</header>
<main>
    <section class="hero tab-panel active" id="start">
        <div class="hero-copy"><p class="eyebrow">@content.Site.Eyebrow</p><h1>@content.Site.HeroTitle</h1><p class="hero-intro">@content.Site.HeroIntro</p><div class="hero-actions"><a class="button button-dark" href="#kullar" data-tab="kullar">Se våra kullar <span>↓</span></a><a class="text-link" href="#om-oss" data-tab="om-oss">Lär känna oss <span>↗</span></a></div></div>
        <div class="hero-visual"><div class="hero-photo" style="background-image:linear-gradient(0deg,rgba(18,34,25,.1),transparent 55%),url('@content.Site.HeroImage')"></div><div class="image-label"><span class="dot"></span> Friluftsliv i fokus</div><div class="stamp">sedan<br><b>2012</b></div></div>
    </section>
    <section class="intro band tab-panel" id="om-oss"><div class="section-kicker">01 / Vår filosofi</div><div class="intro-content"><h2>@content.Site.AboutTitle</h2><div class="intro-text"><p>@content.Site.AboutText</p></div></div><div class="values"><article><span>01</span><h3>Friska individer</h3><p>Vi planerar långsiktigt med hälsa, mentalitet och rastyp i centrum.</p></article><article><span>02</span><h3>Nära uppväxt</h3><p>Valparna växer upp mitt i familjen, med ljud, dofter och trygga rutiner.</p></article><article><span>03</span><h3>Livslånga hem</h3><p>Vi finns med före, under och efter leverans – som stöd hela vägen.</p></article></div></section>
    <section class="dogs section tab-panel" id="hundarna"><div class="section-heading"><div><div class="section-kicker">02 / Våra hundar</div><h2>Två personligheter.<br><em>En röd tråd.</em></h2></div><p>Aktiva, kloka och alltid nära. Möt hundarna som gör Skogsvikens till vad det är.</p></div><div class="dog-grid"><article class="dog-card dog-card-featured"><div class="dog-image" style="background-image:url('@content.Female.Image')"></div><div class="dog-info"><span class="dog-number">01 — TIK</span><h3>@content.Female.Name</h3><p>@content.Female.Bio</p><div class="tags"><span>@content.Female.Year</span>@foreach (var tag in content.Female.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries)) { <span>@tag.Trim()</span> }</div></div></article><article class="dog-card"><div class="dog-image" style="background-image:url('@content.Male.Image')"></div><div class="dog-info"><span class="dog-number">02 — HANE</span><h3>@content.Male.Name</h3><p>@content.Male.Bio</p><div class="tags"><span>@content.Male.Year</span>@foreach (var tag in content.Male.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries)) { <span>@tag.Trim()</span> }</div></div></article></div></section>
    <section class="litter band tab-panel" id="kullar"><div class="litter-header"><div class="section-kicker">03 / Våra kullar</div><h2>Varje kull har<br><em>sin egen historia.</em></h2><p>Välj en kull i menyn för att se föräldrarna, valparna och bilderna.</p></div><div class="litter-menu" id="litter-menu" role="tablist" aria-label="Välj kull">@for (var i = 0; i < litters.Count; i++) { <button class="litter-tab @(i == 0 ? "active" : "")" role="tab" aria-selected="@(i == 0 ? "true" : "false")" data-index="@i">Kull @(litters.Count - i)<small>@litters[i].Year</small></button> }</div><div class="litter-view" id="litter-view">@for (var i = 0; i < litters.Count; i++) { var litter = litters[i]; <article class="server-litter-panel @(i == 0 ? "active" : "")" data-litter-panel="@i"><div class="litter-intro"><span class="status"><span></span> @litter.Year · @litter.Title</span><h3>@litter.Title</h3><p>@litter.Description</p></div><div class="parent-pair"><article class="parent-card"><div class="parent-photo" style="background-image:url('@content.Female.Image')"></div><div><span>TIK</span><h4>@content.Female.Name</h4><p>@content.Female.Bio</p></div></article><article class="parent-card"><div class="parent-photo" style="background-image:url('@content.Male.Image')"></div><div><span>HANE</span><h4>@content.Male.Name</h4><p>@content.Male.Bio</p></div></article></div><div class="puppies-row"><div class="puppies-carousel"><div class="carousel-track">@foreach (var image in litter.Images) { <div class="puppies-slide @(image == litter.Images.First() ? "active" : "")" style="background-image:url('@image')"></div> }</div>@if (litter.Images.Count > 1) { <button class="carousel-arrow prev" aria-label="Föregående bild">‹</button><button class="carousel-arrow next" aria-label="Nästa bild">›</button><div class="carousel-dots">@for (var imageIndex = 0; imageIndex < litter.Images.Count; imageIndex++) { <button class="carousel-dot @(imageIndex == 0 ? "active" : "")" data-slide="@imageIndex" aria-label="Visa bild @(imageIndex + 1)"></button> }</div><span class="carousel-count">@litter.Images.Count bilder</span> }</div><div class="puppies-info"><span class="eyebrow">Valparna</span><h4>Kullen i siffror</h4><div class="puppy-stats"><div><strong>@litter.FemalePuppies</strong><span>Tikvalpar</span></div><div><strong>@litter.MalePuppies</strong><span>Hanvalpar</span></div><div><strong>@litter.TotalPuppies</strong><span>Totalt</span></div></div><a class="button button-dark" href="#kontakt" data-tab="kontakt">Fråga om kullen <span>↗</span></a></div></div></article> }</div></section>
    <section class="daily section tab-panel" id="vardag"><div class="section-heading"><div><div class="section-kicker">04 / En vanlig dag</div><h2>Det enkla är<br><em>det stora.</em></h2></div><p>Tollare mår bäst när de får använda hela sig – nosen, kroppen och huvudet.</p></div><div class="daily-grid"><div class="daily-image" style="background-image:url('@content.Site.DailyImage')"></div><div class="daily-list"><div class="daily-item active"><span>06:45</span><div><h3>Morgon i skogen</h3><p>En stilla promenad över ängarna innan dagens bestyr drar igång.</p></div><b>−</b></div><div class="daily-item"><span>10:30</span><div><h3>Lite hjärngympa</h3><p>Nosarbete, inkallning och en lagom dos problemlösning.</p></div><b>+</b></div><div class="daily-item"><span>16:00</span><div><h3>Valpmys & vila</h3><p>Trygghet byggs i de små stunderna – tillsammans, nära.</p></div><b>+</b></div></div></div></section>
    <section class="contact tab-panel" id="kontakt"><div class="contact-inner"><div><div class="section-kicker">05 / Hör av dig</div><h2>@content.Site.ContactTitle</h2></div><div class="contact-copy"><p>@content.Site.ContactText</p><a class="button button-light" href="mailto:@content.Site.Email">@content.Site.Email <span>↗</span></a><p class="small-note">Vi planerar kullar med omsorg och har därför sällan valpar tillgängliga direkt.</p></div></div></section>
</main>
<footer><div class="brand"><span class="brand-mark">ST</span><span><strong>@content.Site.Name</strong><small>TOLLARE</small></span></div><div class="footer-links"><a href="#start" data-tab="start">Start</a><a href="#kullar" data-tab="kullar">Kullar</a><a href="#kontakt" data-tab="kontakt">Kontakt</a><a href="/Admin">Admin</a></div><span class="copyright">© @DateTime.UtcNow.Year @content.Site.Name</span></footer>
